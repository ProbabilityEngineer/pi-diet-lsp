{
  "name": "pi-diet-lsp",
  "version": "0.1.7",
  "type": "module",
  "description": "On-demand LSP code-intelligence tools for Pi without automatic diagnostics or context injection.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProbabilityEngineer/pi-diet-lsp.git"
  },
  "main": "index.ts",
  "scripts": {
    "lint": "tsc --noEmit",
    "build": "tsc --project tsconfig.json",
    "test:resolution": "node ./scripts/test-resolution.mjs"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "lsp",
    "language-server",
    "code-intelligence"
  ],
  "homepage": "https://github.com/ProbabilityEngineer/pi-diet-lsp#readme",
  "bugs": {
    "url": "https://github.com/ProbabilityEngineer/pi-diet-lsp/issues"
  },
  "license": "MIT",
  "files": [
    "index.ts",
    "README.md",
    "LICENSE",
    "tsconfig.json",
    "scripts"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "typebox": "^1.0.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
